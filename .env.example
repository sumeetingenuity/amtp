# ============================================================
# AMTP Server — Production Environment Variables
# Copy this file to .env and adjust values for your deployment.
# NEVER commit the real .env file to version control.
# ============================================================

# ---- Server ----
AMTP_PORT=3000
AMTP_HOST=0.0.0.0
NODE_ENV=production

# ---- Session ----
AMTP_SESSION_TIMEOUT=86400000          # ms (24 h)
AMTP_SESSION_ABSOLUTE_MAX=604800000   # ms (7 days)

# ---- Rate Limiting ----
AMTP_RATE_LIMIT_WINDOW_MS=60000
AMTP_RATE_LIMIT_MAX_REQUESTS=60

# ---- CORS ----
# Space-separated list of allowed origins (e.g., "https://example.com https://admin.example.com")
# Leave empty to use wildcard (*) — NOT recommended for production
# Set to a single value to close it down: AMTP_TRUSTED_ORIGINS=https://example.com
AMTP_TRUSTED_ORIGINS=

# ---- Body Size ----
AMTP_MAX_REQUEST_BODY_SIZE=1048576    # bytes (1 MB)

# ---- Security Toggles (true/false) ----
AMTP_ENABLE_CORS=true
AMTP_ENABLE_COMPRESSION=true
AMTP_ENABLE_SECURITY_HEADERS=true
AMTP_ENABLE_RATE_LIMIT=true
AMTP_CSRF_PROTECTION=true

# ---- Logging ----
AMTP_LOG_LEVEL=info                   # error | warn | info | debug

# ---- Redis (optional — uncomment for distributed session / rate-limit store) ----
# AMTP_REDIS_URL=redis://localhost:6379
# AMTP_SESSION_STORE=redis
# AMTP_RATELIMIT_STORE=redis
